# 首版使用原助理既有身份，名称与候选发布由同一构建输入绑定。
set(IYW_APP_NAME "原助理" CACHE STRING "Desktop display name")
set(IYW_RELEASE_ID "" CACHE STRING "Fusion candidate release ID")
set(IYW_BRAND_ID "iyw")
if(DEFINED ENV{IYW_BRAND_ID} AND NOT "$ENV{IYW_BRAND_ID}" STREQUAL "")
  set(IYW_BRAND_ID "$ENV{IYW_BRAND_ID}")
endif()
if(NOT IYW_BRAND_ID MATCHES "^[a-z][a-z0-9]+$")
  message(FATAL_ERROR "Invalid brand ID")
endif()
set(IYW_PRODUCT "iyw-claw")
set(IYW_IDENTIFIER "app.iywclaw")
set(IYW_SCHEME "iyw-assistant")
set(IYW_USER_DIRECTORY ".iyw-claw")
set(IYW_INSTALLER_IDENTIFIER "cn.iyw.installer")
set(IYW_UNINSTALL_NAME "原助理")
set(IYW_BRAND_ASSETS "${CMAKE_CURRENT_SOURCE_DIR}/resources")
if(DEFINED ENV{IYW_BRAND_ASSETS} AND NOT "$ENV{IYW_BRAND_ASSETS}" STREQUAL "")
  file(TO_CMAKE_PATH "$ENV{IYW_BRAND_ASSETS}" IYW_BRAND_ASSETS)
endif()
if(NOT IYW_BRAND_ID STREQUAL "iyw")
  string(APPEND IYW_PRODUCT "-${IYW_BRAND_ID}")
  string(APPEND IYW_IDENTIFIER ".${IYW_BRAND_ID}")
  string(APPEND IYW_SCHEME "-${IYW_BRAND_ID}")
  string(APPEND IYW_USER_DIRECTORY "-${IYW_BRAND_ID}")
  string(APPEND IYW_INSTALLER_IDENTIFIER ".${IYW_BRAND_ID}")
  set(IYW_UNINSTALL_NAME "${IYW_IDENTIFIER}")
endif()
if(DEFINED ENV{IYW_BRAND_NAME} AND NOT "$ENV{IYW_BRAND_NAME}" STREQUAL "")
  set(IYW_APP_NAME "$ENV{IYW_BRAND_NAME}")
endif()
if(DEFINED ENV{IYW_RELEASE_ID})
  set(IYW_RELEASE_ID "$ENV{IYW_RELEASE_ID}")
endif()
if(IYW_APP_NAME MATCHES "[\r\n\"\\]")
  message(FATAL_ERROR "Invalid application display name")
endif()
if(NOT IYW_RELEASE_ID MATCHES "^[0-9]*$")
  message(FATAL_ERROR "IYW_RELEASE_ID must contain decimal digits")
endif()
set(IYW_PROMOTION_CHANNEL "stable")
if(DEFINED ENV{IYW_PROMOTION_CHANNEL})
  set(IYW_PROMOTION_CHANNEL "$ENV{IYW_PROMOTION_CHANNEL}")
endif()
if(NOT IYW_PROMOTION_CHANNEL MATCHES "^(stable|beta)$")
  message(FATAL_ERROR "Invalid promotion channel")
endif()
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/resources/brand.generated.h.in"
  "${CMAKE_CURRENT_BINARY_DIR}/generated/brand.generated.h" @ONLY)
set(IYW_RUNTIME_LOGO "${IYW_BRAND_ASSETS}/icon.png")
if(NOT EXISTS "${IYW_RUNTIME_LOGO}")
  set(IYW_RUNTIME_LOGO "${CMAKE_CURRENT_SOURCE_DIR}/resources/runtime-logo.png")
endif()
file(READ "${IYW_RUNTIME_LOGO}" IYW_LOGO_BYTES HEX)
file(READ "${IYW_BRAND_ASSETS}/icon.ico" IYW_ICON_BYTES HEX)
file(SHA256 "${IYW_RUNTIME_LOGO}" IYW_LOGO_DIGEST)
file(SHA256 "${IYW_BRAND_ASSETS}/icon.ico" IYW_ICON_DIGEST)
string(REGEX REPLACE "(..)" "0x\\1," IYW_LOGO_BYTES "${IYW_LOGO_BYTES}")
string(REGEX REPLACE "(..)" "0x\\1," IYW_ICON_BYTES "${IYW_ICON_BYTES}")
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/resources/runtime-brand-assets.h.in"
  "${CMAKE_CURRENT_BINARY_DIR}/generated/runtime-brand-assets.h" @ONLY)
